#!/usr/bin/env python3
"""
analyze_no_cases.py — Classify the 344 herd7 "No" violations from the
kernel-noLTO mbcheck sweep into true positives, false positives, and
borderline/needs-review cases.

Usage:
    python3 src/script/analyze_no_cases.py \
        [--log   build/kernel_noLTO_results.log] \
        [--litmus-dir build/litmus]              \
        [--ir-dir     tests/kernel-noLTO]        \
        [--out   docs/no_cases_analysis.md]

The script reads the herd7 run log, identifies all "No" litmus tests,
extracts the anchor function + type for each, and applies a
rule-based classification.  It then optionally re-reads the corresponding
IR to cross-check lock aliasing for the largest false-positive categories.
"""

import argparse
import os
import re
import sys
from collections import Counter, defaultdict
from dataclasses import dataclass, field
from pathlib import Path
from typing import Optional


# ---------------------------------------------------------------------------
# Verdict labels
# ---------------------------------------------------------------------------
FP   = "FALSE_POSITIVE"
TP   = "POSSIBLY_TRUE_POSITIVE"
BORD = "BORDERLINE"
UNKN = "UNKNOWN"


# ---------------------------------------------------------------------------
# Per-module classification rules
# (module_name -> (verdict, category_label, explanation))
# ---------------------------------------------------------------------------
MODULE_RULES: dict[str, tuple[str, str, str]] = {
    "psmouse": (
        FP,
        "Driver probe/disconnect serialised by psmouse_mutex",
        "All psmouse *_init / *_set_protocol / *_disconnect callbacks are invoked "
        "exclusively under psmouse_mutex, held by the serio input-layer driver.  "
        "The mutex is passed as an argument to mutex_lock() from outside the module "
        "IR, so LockAliasHeuristic cannot see it.",
    ),
    "pptt": (
        FP,
        "ACPI PPTT boot-time initialisation (acpi_get_pptt globals)",
        "All PPTT functions (cache_setup_acpi, acpi_get_cache_info, "
        "find_acpi_cpu_topology_*, acpi_pptt_*) share @acpi_get_pptt.pptt and "
        "@acpi_get_pptt.is_pptt_checked, but the PPTT table is parsed once before "
        "secondary CPUs come fully online.  The anchor is _printk[SC] reaching a "
        "WARN_ONCE write (@acpi_pptt_warn_missing.__already_done).  "
        "LifecycleHeuristic does not cover boot-time ACPI init functions.",
    ),
    "vt": (
        FP,
        "VT console operations serialised by console_lock",
        "vc_allocate and all partner functions (poke_blanked_console, set_console, "
        "do_bind_con_driver, vc_deallocate …) are called under console_lock.  "
        "console_lock is a global semaphore not visible in vt.ll's call graph.",
